<?xml version="1.0" encoding="utf-8"?>
<!--
  Источник пакетов задаётся в репозитории, а не берётся из настроек машины.
  Причина: восстановление должно давать одинаковый результат у любого,
  кто склонировал проект, независимо от того, что настроено у него в NuGet.
  <clear /> отбрасывает машинные источники намеренно.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
