<Window x:Class="WindowsPeace.Setup.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Peace" Height="720" Width="1024"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Tahoma, Microsoft Sans Serif">
    <!--
        Цепочка шрифтов, а не один. Обычного начертания Segoe UI в образе WinPE
        нет — есть жирное, курсив и светлое; обычное лежит отдельным файлом
        в sources\segoeui.ttf и подгружается установщиком Windows на время
        своей работы. Проверено чтением образа. Tahoma и Microsoft Sans Serif
        в образе есть, и обе с кириллицей.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="24" Margin="0,0,0,16" />

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <!--
                Выход один на все экраны и всегда здесь, в противоположном углу
                от «Далее»: случайно нажать его вместо перехода нельзя, а искать
                его в разных местах разных экранов человек не должен. В WinPE
                окно занимает весь экран и крестика на нём нет — без этой кнопки
                оставалось бы выключить машину из розетки.
            -->
            <Button Content="Закрыть мастер" Command="{Binding CloseCommand}"
                    AutomationProperties.AutomationId="Close"
                    HorizontalAlignment="Left" Height="34" Padding="12,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назад" Command="{Binding BackCommand}"
                        AutomationProperties.AutomationId="Back"
                        MinWidth="120" Height="34" Padding="12,0" Margin="0,0,12,0" />

                <!--
                    Слово на кнопке даёт сама страница: после сводки это «Установить».
                    Поэтому у кнопок есть и неизменные метки: средства проверки
                    ищут «кнопку вперёд», а не слово, которое сегодня одно,
                    а завтра другое.
                -->
                <Button Content="{Binding NextTitle}" Command="{Binding NextCommand}"
                        AutomationProperties.AutomationId="Next"
                        MinWidth="120" Height="34" Padding="12,0" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
