<UserControl x:Class="WindowsPeace.Setup.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Полоски прогресса здесь намеренно нет. Она выглядела бы убедительно
        ровно до того дня, когда о её ненастоящести забудут, — а за этим экраном
        разметка диска.
    -->
    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" VerticalAlignment="Top" />
</UserControl>
