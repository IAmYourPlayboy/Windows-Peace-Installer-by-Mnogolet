<UserControl x:Class="WindowsPeace.Setup.Pages.DiskPickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Преобразователи BoolToVisibility и RemainingWidth лежат в App.xaml: они общие. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            IsSynchronizedWithCurrentItem="False" обязателен. По умолчанию список
            синхронизирует выделение с «текущим элементом» коллекции, а текущий —
            первый. Экран открывался бы с уже выбранным диском и включённой кнопкой
            «Далее», хотя человек ничего не выбирал.

            Диски-гармошкой: клик по строке диска и стрелки влево/вправо сворачивают
            и разворачивают его разделы. Обработчики - в коде экрана, а само
            сворачивание живёт в модели списка и проверено тестами.
        -->
        <ListView x:Name="DiskList" Grid.Row="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  IsSynchronizedWithCurrentItem="False"
                  PreviewMouseLeftButtonUp="DiskList_PreviewMouseLeftButtonUp"
                  PreviewKeyDown="DiskList_PreviewKeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!--
                        Невыбираемую строку отключаем: так клавиатура её пропускает
                        и не выбирает, а родное приглушение отключённой строки
                        показывает, что сюда нельзя. Свернуть её тоже нельзя -
                        стрелки у неё поэтому и нет (см. CanToggle).
                    -->
                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <!--
                        Ширины столбцов подобраны под окно в центре с полями по краям:
                        жёсткая их часть обязана уместиться так, чтобы последнему
                        столбцу «Состояние» осталось не меньше его минимума, иначе
                        объяснение «почему на диск нельзя» ужимается и уезжает
                        за край - а этого нельзя ни при какой ширине окна.
                    -->
                    <GridViewColumn Header="Имя" Width="268">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="{Binding Indent}" />
                                    <!--
                                        Стрелка сворачивания у дисков с разделами.
                                        Рисуем вектором, а не символом шрифта:
                                        в WinPE какой шрифт подставится - неизвестно,
                                        а треугольник нужен точно.
                                    -->
                                    <Grid Width="16" VerticalAlignment="Center"
                                          Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}">
                                        <Path Data="M0,2 L8,2 L4,7 Z" Fill="{StaticResource InkBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                        <Path Data="M2,0 L7,4 L2,8 Z" Fill="{StaticResource InkBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Объём" Width="90" DisplayMemberBinding="{Binding Size}" />
                    <GridViewColumn Header="Свободно" Width="98" DisplayMemberBinding="{Binding Free}" />
                    <GridViewColumn Header="Тип" Width="118" DisplayMemberBinding="{Binding Type}" />

                    <!--
                        Последний столбец занимает всё оставшееся место, а его текст
                        переносится по строкам. Здесь лежит объяснение, почему на диск
                        нельзя ставить, — обрезать его нельзя ни при какой ширине окна.
                    -->
                    <GridViewColumn Header="Состояние">
                        <GridViewColumn.Width>
                            <MultiBinding Converter="{StaticResource RemainingWidth}">
                                <Binding ElementName="DiskList" Path="ActualWidth" />
                                <Binding ElementName="DiskList" />
                            </MultiBinding>
                        </GridViewColumn.Width>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,12,0" Padding="10,4" />
            <Button Content="Прервать" Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="10,4" />
            <Button Content="Создать" IsEnabled="{Binding CanCreate}" Margin="0,0,12,0" Padding="10,4" Click="NotYet" />
            <Button Content="Удалить" IsEnabled="{Binding CanDelete}" Margin="0,0,12,0" Padding="10,4" Click="NotYet" />
            <Button Content="Форматировать" IsEnabled="{Binding CanFormat}" Margin="0,0,12,0" Padding="10,4" Click="NotYet" />
            <Button Content="Расширить" IsEnabled="{Binding CanExtend}" Margin="0,0,12,0" Padding="10,4" Click="NotYet" />
            <Button Content="Подробно" IsEnabled="{Binding CanShowDetails}" Margin="0,0,12,0" Padding="10,4" Click="NotYet" />
            <Button Content="Загрузить драйвер" Padding="10,4" Click="NotYet" />
        </WrapPanel>

        <!--
            Пока идёт опрос, человек видит и полоску, и словами — чем программа занята.
            Состояние «крутится, и непонятно, живо ли оно» запрещено разделом 9
            архитектуры, поэтому рядом всегда есть кнопка «Прервать».
        -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Height="4" />
            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{StaticResource TroubleBrush}"
                   TextWrapping="Wrap" Text="{Binding EnumerationError}" />

        <!--
            Причина отказа - единственное, что осталось внизу. Она контекстная:
            видна только когда выбрали то, куда нельзя, и объясняет почему.
        -->
        <TextBlock Grid.Row="4" Margin="0,12,0,0" Foreground="{StaticResource TroubleBrush}"
                   TextWrapping="Wrap" Text="{Binding DenialReason}" />
    </Grid>
</UserControl>
