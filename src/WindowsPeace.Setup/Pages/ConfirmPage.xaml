<UserControl x:Class="WindowsPeace.Setup.Pages.ConfirmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Сводка длиннее экрана быть не должна, но предупреждений может набраться
        сколько угодно, а в WinPE окно не изменить в размерах. Обрезанное
        предупреждение — это непрочитанное предупреждение.
    -->
    <!--
        Focusable="False" обязателен и здесь, и у списка предупреждений.
        По умолчанию оба ящика — остановки для клавиши Tab, хотя нажать в них
        нечего: до единственного поля на экране человек без мыши добирался
        третьим нажатием. Проверено на стенде в WinPE.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
            <!--
                Только объяснение своими словами. Выход отсюда есть всегда —
                кнопка «Назад» на этом экране доступна, поэтому своей кнопки
                выхода здесь не нужно.
            -->
            <TextBlock Text="{Binding Trouble}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Foreground="{StaticResource TroubleBrush}"
                       Visibility="{Binding HasTrouble, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Что ставим" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="{Binding RecipeName}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Text="Куда ставим" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="{Binding DiskModel}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DiskSummary}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Text="Что будет сделано" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="{Binding PlanEffect}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- Шаблон предупреждения общий с экраном выбора диска, он в App.xaml. -->
            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,16" Focusable="False" />

            <StackPanel Visibility="{Binding NeedsTypedConfirmation, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                    <Run Text="Чтобы продолжить, введите модель диска:" />
                    <Run Text="{Binding DiskModel, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>

                <!--
                    UpdateSourceTrigger=PropertyChanged обязателен: по умолчанию
                    введённое доходит до модели только при уходе из поля,
                    и кнопка оживала бы не тогда, когда человек дописал строку,
                    а когда щёлкнул мимо.
                -->
                <TextBox x:Name="ModelBox"
                         Text="{Binding TypedModel, UpdateSourceTrigger=PropertyChanged}"
                         Width="360" HorizontalAlignment="Left" Padding="4,3" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
