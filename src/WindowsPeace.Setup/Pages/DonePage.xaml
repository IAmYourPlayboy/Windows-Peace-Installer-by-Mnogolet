<UserControl x:Class="WindowsPeace.Setup.Pages.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Своей кнопки выхода здесь нет: «Закрыть мастер» стоит в углу оболочки
        и одинакова на всех экранах. На шаге В сюда придёт «Перезагрузить» —
        это другое действие, а не второй выход.
    -->
    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" VerticalAlignment="Top" />
</UserControl>
