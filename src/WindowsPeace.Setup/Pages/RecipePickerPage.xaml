<UserControl x:Class="WindowsPeace.Setup.Pages.RecipePickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowsPeace.Setup.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="{loc:T recipe.intro}"
                   Visibility="{Binding HasRecipes, Converter={StaticResource BoolToVisibility}}" />

        <!--
            Беда с носителем показывается выше списка и не прячется за него:
            когда ставить нечего, человек должен прочитать почему, а не гадать
            над пустой таблицей. Выход из тупика есть всегда — кнопка «Закрыть
            мастер» в углу оболочки, одна и та же на всех экранах.

            Только объяснение своими словами. Техническая причина — текст
            разборщика, отказ файловой системы — на экран не выносится
            и целиком уходит в журнал: разбираться в наших ошибках человеку
            у флешки незачем, это наша работа. Решение автора.
        -->
        <TextBlock Grid.Row="1" Text="{Binding Trouble}" TextWrapping="Wrap"
                   Foreground="{StaticResource TroubleBrush}"
                   Visibility="{Binding HasTrouble, Converter={StaticResource BoolToVisibility}}" />

        <!--
            IsSynchronizedWithCurrentItem="False" обязателен. По умолчанию список
            синхронизирует выделение с «текущим элементом» коллекции, а текущий —
            первый. Экран открывался бы с уже выбранным рецептом и включённой
            кнопкой «Далее», хотя человек ничего не выбирал. Этот дефект уже
            ловили на шаге А; спека требует обратного: даже единственный рецепт
            человек выбирает сам, потому что должен видеть, что он ставит.
        -->
        <ListView x:Name="RecipeList" Grid.Row="2"
                  ItemsSource="{Binding Recipes}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  IsSynchronizedWithCurrentItem="False"
                  Visibility="{Binding HasRecipes, Converter={StaticResource BoolToVisibility}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:T recipe.col.name}" Width="260" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="{loc:T recipe.col.image}" Width="200" DisplayMemberBinding="{Binding Image}" />
                    <GridViewColumn Header="{loc:T recipe.col.size}" Width="100" DisplayMemberBinding="{Binding Size}" />

                    <!--
                        Последний столбец занимает всё оставшееся место, а его текст
                        переносится по строкам: описание рецепта — это единственное
                        место, где сказано, чем одна сборка отличается от другой,
                        и обрезать его нельзя ни при какой ширине окна.
                    -->
                    <GridViewColumn Header="{loc:T recipe.col.what}">
                        <GridViewColumn.Width>
                            <MultiBinding Converter="{StaticResource RemainingWidth}">
                                <Binding ElementName="RecipeList" Path="ActualWidth" />
                                <Binding ElementName="RecipeList" />
                            </MultiBinding>
                        </GridViewColumn.Width>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
